# Local development defaults. Copy of finally/.env.example; fill in real keys locally.
# Never commit real secrets to this file.

# OpenRouter API key used for LLM calls. Placeholder only; set a real key locally.
OPENROUTER_API_KEY=your-openrouter-api-key-here

# Massive market data API key (optional). Leave EMPTY to use the built-in market simulator.
MASSIVE_API_KEY=

# Set to true to use deterministic mock LLM responses instead of calling OpenRouter.
LLM_MOCK=true
