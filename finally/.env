# Local development configuration.
# If you export OPENROUTER_API_KEY in your shell, start_mac.sh will automatically preserve it.

# Massive market data API key (optional). Leave EMPTY to use the built-in market simulator.
MASSIVE_API_KEY=

# Set to true to use deterministic mock LLM responses. If unset and a real OPENROUTER_API_KEY is found, defaults to false.
LLM_MOCK=
